rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'lastLessonTopic', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('lastLessonTopic' in data) || (data.lastLessonTopic is string && data.lastLessonTopic.size() <= 180))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedLessonRecord(data, userId, lessonId) {
      return data.keys().hasAll(['id', 'userId', 'topicTitle', 'subject', 'engine', 'stepCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'topicTitle', 'subject', 'engine', 'stepCount', 'createdAt', 'updatedAt'])
        && data.id is string
        && isValidId(data.id)
        && data.id == lessonId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.topicTitle is string
        && data.topicTitle.size() >= 1
        && data.topicTitle.size() <= 180
        && data.subject is string
        && data.subject in ['math', 'geometry', 'physics', 'chemistry', 'biology', 'history', 'language']
        && data.engine is string
        && data.engine in ['plotly2d', 'plotly3d', 'threejs', 'pdb', 'pubchem', 'mermaid', 'svg2d']
        && data.stepCount is int
        && data.stepCount >= 1
        && data.stepCount <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'lastLessonTopic', 'updatedAt']);
      allow delete: if false;

      match /lessons/{lessonId} {
        allow get: if isValidId(userId)
          && isValidId(lessonId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(lessonId)
          && isOwner(userId)
          && isValidSavedLessonRecord(incoming(), userId, lessonId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(lessonId)
          && isOwner(userId)
          && isValidSavedLessonRecord(incoming(), userId, lessonId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['topicTitle', 'subject', 'engine', 'stepCount', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId)
          && isValidId(lessonId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    function isValidVideoLessonCache(data, videoId) {
      return data.keys().hasAll([
          'videoId',
          'lessonId',
          'selectedModelId',
          'lessonTitleUz',
          'sourceChannel',
          'createdByUid',
          'segments',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'videoId',
          'lessonId',
          'selectedModelId',
          'lessonTitleUz',
          'sourceChannel',
          'createdByUid',
          'segments',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.videoId)
        && data.videoId == videoId
        && isValidId(data.lessonId)
        && data.selectedModelId is string
        && data.selectedModelId in ['electric_motor', 'human_heart', 'atom_bohr', 'plant_cell', 'none_2d_board']
        && data.lessonTitleUz is string
        && data.lessonTitleUz.size() >= 1
        && data.lessonTitleUz.size() <= 200
        && data.sourceChannel is string
        && data.sourceChannel in ['youtube_extension', 'local_audio', 'image_topic', 'mock_demo']
        && isValidId(data.createdByUid)
        && data.createdByUid == request.auth.uid
        && data.segments is list
        && data.segments.size() >= 1
        && data.segments.size() <= 15
        && data.segments[0] is map
        && data.segments[0].keys().hasAll([
          'start_sec',
          'end_sec',
          'uzbek_title',
          'uzbek_explanation',
          'camera_hotspot',
          'emoji_mimic'
        ])
        && data.segments[0].keys().hasOnly([
          'start_sec',
          'end_sec',
          'uzbek_title',
          'uzbek_explanation',
          'camera_hotspot',
          'emoji_mimic',
          'key_formula_or_term'
        ])
        && data.segments[0].start_sec is number
        && data.segments[0].end_sec is number
        && data.segments[0].uzbek_title is string
        && data.segments[0].uzbek_title.size() >= 1
        && data.segments[0].uzbek_title.size() <= 200
        && data.segments[0].uzbek_explanation is string
        && data.segments[0].uzbek_explanation.size() >= 1
        && data.segments[0].uzbek_explanation.size() <= 1500
        && data.segments[0].camera_hotspot is string
        && data.segments[0].camera_hotspot.size() >= 1
        && data.segments[0].camera_hotspot.size() <= 64
        && data.segments[0].emoji_mimic is string
        && data.segments[0].emoji_mimic in ['explaining', 'amazed', 'thinking', 'happy', 'warning']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /videoLessons/{videoId} {
      allow get: if isValidId(videoId) && isVerified();
      allow list: if false;
      allow create: if isValidId(videoId)
        && isVerified()
        && isValidVideoLessonCache(incoming(), videoId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(videoId)
        && isVerified()
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdByUid == request.auth.uid
        && isValidVideoLessonCache(incoming(), videoId)
        && incoming().videoId == existing().videoId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lessonId',
          'selectedModelId',
          'lessonTitleUz',
          'sourceChannel',
          'segments',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
